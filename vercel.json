{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api-unisalento/:path*",
      "destination": "https://logistica.unisalento.it/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/|@|src/|node_modules/|public/|favicon.ico|manifest.json|icona.png|.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/check-lessons",
      "schedule": "0 5 * * *"
    }
  ]
}
